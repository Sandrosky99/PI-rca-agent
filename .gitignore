# Fichero .env con credenciales reales — NUNCA subir a git
.env

# Entorno virtual de Python — se regenera con setup.bat
.venv/

# Logs del webhook — NUNCA subir a git.
# webhook.log registra el request completo de PI y los prompts enteros de los
# Steps 3 y 6, incluyendo la estructura del AF y las series de datos de planta.
# El patrón con * cubre también los ficheros de rotación (webhook.log.1 … .5).
webhook.log*

# Logs del servicio de Windows (NSSM, ver install_service.bat)
logs/

# NSSM (Non-Sucking Service Manager) - binario de terceros, no se versiona.
# Lo necesita install_service.bat para registrar el servicio de Windows.
# Descargar de https://nssm.cc/download y copiar win64/nssm.exe aqui.
# Version verificada: 2.24, SHA256 del exe
# F689EE9AF94B00E9E3F0BB072B34CAAF207F32DCB4F5782FC9CA351DF9A06C97
nssm.exe

# Audit trail — NUNCA subir a git.
# Registra cada operación con efectos, incluyendo nombres de activo y rutas de
# PI. Debe conservarse (observability-spec §2.4), pero fuera del repositorio.
audit.jsonl*

# Registro de incidentes — NUNCA subir a git.
# Cada fichero guarda el payload completo de una alerta real y el diagnóstico
# producido: nombres de activos, valores de proceso y datos de planta. Mismo
# motivo que webhook.log. Es el archivo de casos, no material desechable:
# si hay que respaldarlo, que sea fuera del repositorio.
incidents/

# Carpetas de caché que Python genera automáticamente
__pycache__/
*.pyc

# Carpetas de distribución (si se empaqueta el proyecto)
dist/
*.egg-info/
