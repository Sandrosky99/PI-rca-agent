# =============================================================================
# RCA Workflow — Plantilla de configuración
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este fichero y renómbralo ".env"  (sin el ".example")
#   2. Rellena los valores que necesitas
#   3. El fichero ".env" NUNCA debe subirse a git (ya está en .gitignore)
# =============================================================================


# -----------------------------------------------------------------------------
# OBLIGATORIO
# -----------------------------------------------------------------------------

# Proveedor de LLM que usará el workflow para razonar: "gemini" (por defecto),
# "anthropic" o "deepseek". Solo hace falta rellenar la API key del proveedor
# elegido; las demás pueden quedarse vacías.
LLM_PROVIDER=gemini

# Clave de API de Google (Gemini). Obligatoria si LLM_PROVIDER=gemini.
# Puedes obtenerla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=aqui-va-tu-clave-de-gemini

# Clave de API de Anthropic. Obligatoria SOLO si LLM_PROVIDER=anthropic.
# Puedes obtenerla (o crearla) en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-aqui-va-tu-clave

# Clave de API de DeepSeek. Obligatoria SOLO si LLM_PROVIDER=deepseek.
# Puedes obtenerla en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-aqui-va-tu-clave-de-deepseek


# -----------------------------------------------------------------------------
# OPCIONALES (tienen valor por defecto si se dejan en blanco)
# -----------------------------------------------------------------------------

# Modelo de Gemini a usar (solo si LLM_PROVIDER=gemini).
# Por defecto: gemini-2.5-flash (gemini-2.5-pro requiere facturación activada
# en el proyecto de Google Cloud; sin ella devuelve error 429 de cuota 0).
GEMINI_MODEL=

# Modelo de Claude a usar (solo si LLM_PROVIDER=anthropic).
# Por defecto: claude-opus-4-8
ANTHROPIC_MODEL=

# Razonamiento extendido de Claude (solo si LLM_PROVIDER=anthropic).
# Por defecto: true. Esta encendido para que los dos proveedores se comporten
# igual -- gemini-2.5-flash razona por defecto -- y no para mejorar el
# diagnostico, que es algo que todavia no hay forma de medir.
# Ponlo en false para comparar con y sin el, o si las llamadas se alargan
# demasiado. Es "adaptive": el modelo decide cuanto razona en cada paso.
ANTHROPIC_THINKING=

# Modelo de DeepSeek a usar (solo si LLM_PROVIDER=deepseek).
# Por defecto: deepseek-flash. El grande es deepseek-v4-pro.
DEEPSEEK_MODEL=

# Endpoint de DeepSeek compatible con el protocolo de Anthropic.
# Por defecto: https://api.deepseek.com/anthropic
# Solo hay que tocarlo si pasas por una pasarela interna.
DEEPSEEK_BASE_URL=

# Techo de tokens solo para DeepSeek (razonamiento + respuesta).
# Por defecto: 64000, frente a los 32000 de LLM_MAX_TOKENS. Tiene techo propio
# porque razona siempre y lo que razona varia mucho: medido sobre el Step 6 de
# un reanalisis real, el consumo tipico ronda los 15.000 tokens y dos vueltas
# malas agotaron 16.000 y 32.000 antes de escribir nada.
DEEPSEEK_MAX_TOKENS=

# Techo de tokens de la respuesta del modelo, para ambos proveedores.
# Es un techo duro: si se alcanza, la respuesta se corta a mitad del JSON y el
# analisis se pierde. La respuesta del Step 4 con 30 variables ya ocupa ~2.800
# tokens, y con MAX_SELECTED_VARIABLES=40 puede llegar a ~3.700.
# Subirlo no cuesta nada: solo se pagan los tokens realmente generados.
# Por defecto: 32000
LLM_MAX_TOKENS=

# Puerto en el que escuchará el servidor webhook.
# PI System debe apuntar sus notificaciones a: http://ESTE_SERVIDOR:<WEBHOOK_PORT>/notification
# Por defecto: 8090  (el 8080 está ocupado por IIS en el servidor actual)
WEBHOOK_PORT=8090

# Token secreto para verificar que las notificaciones vienen de PI System.
# Si lo configuras, PI debe enviar el mismo valor en la cabecera "X-PI-Secret".
#
# En este despliegue se deja VACIO a proposito: el canal de entrega HTTP de PI
# Notifications no permite anadir cabeceras propias, asi que exigirla dejaria el
# webhook rechazando todas las notificaciones legitimas. Ver "DECISIONES DE
# SEGURIDAD" en webhook.py. Rellenarlo solo si el emisor puede enviarla.
WEBHOOK_SECRET=

# Expone GET /notifications/history con las ultimas 50 notificaciones COMPLETAS
# (activo, jerarquia de planta, KPI, umbral) sin autenticar.
# APAGADO POR DEFECTO. Encenderlo solo de forma temporal para depurar una
# integracion nueva, y volver a apagarlo. El registro de incidentes cubre hoy
# esa necesidad mejor y sin exponer nada por HTTP.
# Por defecto: false
NOTIFICATION_HISTORY_ENABLED=

# Zona horaria del servidor para mostrar los timestamps en el log.
# Valores válidos: nombres de zona IANA, p.ej. Europe/Madrid, America/New_York
# Por defecto: Europe/Madrid
PI_LOCAL_TIMEZONE=Europe/Madrid


# -----------------------------------------------------------------------------
# OBSERVABILIDAD Y PARADA EN CALIENTE
# -----------------------------------------------------------------------------

# Log de aplicacion: una linea JSON por evento, rotativo a 10 MB x 5.
# Por defecto: <carpeta del proyecto>\webhook.log
LOG_FILE=

# Audit trail. DEBE ser un fichero distinto del log de aplicacion y sobrevivir a
# los reinicios (observability-spec 2.3 y 2.4). Formato JSON Lines, append-only.
# Por defecto: <carpeta del proyecto>udit.jsonl
AUDIT_FILE=

# Interruptor de parada en caliente (ai-governance 9.5).
# Con WORKFLOW_ENABLED=false el webhook SIGUE aceptando y registrando las
# notificaciones de PI -- no se pierde ninguna alerta -- pero NO lanza ningun
# analisis: ni LLM ni MCP servers. Los incidentes quedan en estado 'pausado'.
# Permite cortar el comportamiento automatico sin desplegar ni revertir nada.
# Requiere reiniciar el proceso tras cambiarlo.
# Por defecto: true
WORKFLOW_ENABLED=


# -----------------------------------------------------------------------------
# REGISTRO DE INCIDENTES (deduplicacion y persistencia)
# -----------------------------------------------------------------------------
# Un fichero JSON por incidente. Sirve a la vez para no analizar dos veces la
# misma alerta y para que un analisis no se pierda en silencio si el proceso
# se reinicia. Los ficheros NO se borran solos: son el archivo de casos.

# Carpeta del registro. Esta en .gitignore: guarda payloads y diagnosticos con
# datos de planta.
# Por defecto: <carpeta del proyecto>\incidents
INCIDENTS_DIR=

# Minutos durante los que una alerta del mismo activo y KPI se considera el
# mismo incidente, aunque llegue con otro StartTime. Protege del caso en que PI
# abra un event frame nuevo en cada evaluacion de la alarma.
# 0 desactiva esta capa y deja solo la deduplicacion exacta por StartTime.
#
# Recuerda: esto es una red de seguridad. La deduplicacion se arregla en PI,
# con el NonrepetitionInterval de la Notification Rule y el deadband del
# analisis que calcula el KPI.
# Por defecto: 20
INCIDENT_COOLDOWN_MINUTES=

# Cuantos analisis pueden ejecutarse A LA VEZ. Los que sobran esperan turno en
# estado 'recibido'; no se rechaza ninguna alerta.
#
# La deduplicacion protege de repetir el MISMO incidente, no de que cinco
# activos distintos disparen a la vez. Cada analisis consulta PI Web API, y PI
# es el historiador de la planta: lo usan mas cosas que este workflow, entre
# ellas PI Vision. Degradarlo con consultas en paralelo seria peor que tardar
# unos minutos mas en diagnosticar.
#
# 0 o menos desactiva el limite.
# Por defecto: 3
MAX_CONCURRENT_ANALYSES=

# Segundos que se espera a UNA llamada al modelo antes de darla por perdida.
# Una respuesta real del Step 6 ronda los 2.800 tokens y tarda menos de un
# minuto, asi que 120 va holgado.
# Por defecto: 120
LLM_TIMEOUT_SECONDS=

# Tope DURO de un analisis completo, de principio a fin. Es la unica garantia
# que cubre tambien las llamadas MCP de los Steps 2 y 5, que no tienen timeout
# propio y pueden colgarse indefinidamente.
#
# Con este valor y MAX_CONCURRENT_ANALYSES, la espera peor de una alerta en
# cola es calculable: ceil(alertas / simultaneos) x este tope.
# Por defecto: 600 (10 minutos)
ANALYSIS_TIMEOUT_SECONDS=

# Cuanto se sigue reintentando UNA llamada al modelo cuando el error es de los
# que se arreglan solos (5xx, limite de ritmo, conexion). Se cuenta por tiempo
# y no por numero de intentos: lo que importa es cuanto corte se aguanta.
#
# El valor sale de la cuenta del presupuesto de ANALYSIS_TIMEOUT_SECONDS, no
# del aire. Si se sube esto, hay que subir tambien aquello.
# Por defecto: 90
LLM_RETRY_WINDOW_SECONDS=

# Dias tras los cuales se PODA el "trace" de un incidente: los prompts enviados
# al modelo y sus respuestas. El caso en si -- payload, estado, diagnostico y,
# cuando exista, la revision humana -- NO se borra nunca.
#
# El trace es el 98,9 % del peso de un incidente (medido: 501 KB de 507 KB).
# Podarlo recorta el 99 % del espacio sin tocar lo que hace falta para evaluar
# si los diagnosticos aciertan. Queda constancia de que se podo y de que habia.
#
# 90 dias da tiempo de sobra a que alguien cuestione un diagnostico y se
# investigue con el prompt original delante. 0 desactiva la poda.
# Por defecto: 90
INCIDENT_TRACE_RETENTION_DAYS=


# -----------------------------------------------------------------------------
# CONSULTAS A LOS MCP SERVERS (Steps 2 y 5)
# -----------------------------------------------------------------------------
# Los dos servidores MCP se lanzan como subproceso ("uv run --directory ..."),
# no hace falta arrancarlos a mano. Estas rutas solo hay que tocarlas si los
# proyectos no están en su ubicación habitual.

# Carpeta del proyecto afkg-graph-mcp (Step 2: estructura real del Asset Framework).
# Por defecto: C:\MCPServer\afkg-graph-mcp
# Ruta del ejecutable de uv, que es quien lanza los dos servidores MCP.
# Por defecto se resuelve sola (shutil.which). Solo hay que ponerla si el
# proceso no encuentra uv en su PATH -- caso real el 2026-10-08: un servicio
# de larga vida arrancado antes de que la carpeta .local\bin del usuario
# entrara en el PATH moria con FileNotFoundError [WinError 2] a mitad del
# Step 2, sin decir que fichero no encontraba.
# Ejemplo: C:\Users\<usuario>\.local\bin\uv.exe
UV_BINARY=

AFKG_GRAPH_MCP_DIR=

# Carpeta del proyecto aveva-pi-mcp (Step 5: datos históricos de PI Web API).
# Por defecto: C:\MCPServer\MCP Server
AVEVA_PI_MCP_DIR=

# Horas hacia atrás desde la detección para la PRIMERA consulta del histórico.
# Se mira siempre hacia atrás: las alertas son degradaciones graduales de KPI,
# no picos instantáneos.
#
# Es un punto de partida, no un límite: 24 h bastan para una degradación
# gradual (validado en pruebas reales, donde la tendencia ya se ve en las
# últimas ~14 h) y mantienen el prompt del Step 6 en un tamaño razonable. Si el
# modelo, ya con los datos delante, necesita más, lo pide y el workflow repite
# los Steps 5-6 con una ventana mayor (ver MAX_HISTORY_ADJUSTMENTS).
# Por defecto: 24
PI_LOOKBACK_HOURS=

# Resolución temporal de la PRIMERA consulta (intervalo entre puntos).
# Uniforme para todas las variables, para poder correlacionarlas por timestamp.
# En las ampliaciones se recalcula sola (ver PI_TARGET_POINTS_PER_VARIABLE).
# Por defecto: 15 minutes
PI_QUERY_INTERVAL_VALUE=
PI_QUERY_INTERVAL_UNIT=

# Techo absoluto de la ventana. El modelo puede pedir más histórico, pero el
# código decide cuánto concede: la petición se recorta a este valor.
# Por defecto: 336  (14 días)
PI_MAX_LOOKBACK_HOURS=

# Cuántas veces se permite repetir los Steps 5-6 con otra ventana, a petición
# del modelo. Cuenta los reajustes en las dos direcciones: ampliaciones y
# estrechamientos. Cada uno cuesta una consulta a PI (barata) y una llamada al
# LLM (no tanto). 0 desactiva el mecanismo por completo.
# Por defecto: 1
MAX_HISTORY_ADJUSTMENTS=

# Catálogo de ventanas (en horas) que se le ofrecen al modelo. Va en las dos
# direcciones: hacia arriba para tendencias lentas, hacia abajo para fenómenos
# que a 15 minutos son invisibles (cavitación, golpe de ariete, ciclado de
# arranques). La resolución de cada opción NO se pone aquí: se deriva de
# PI_TARGET_POINTS_PER_VARIABLE, para que sea proporcional a la ventana.
# Estrechar solo se concede si la ventana sigue cubriendo el inicio de la
# desviación, que el modelo debe indicar en trend_start.
# Por defecto: 2,8,24,48,168,336  (2 h, 8 h, 24 h, 2 d, 7 d, 14 d)
PI_WINDOW_LADDER_HOURS=

# Puntos por variable a los que se aspira al ampliar la ventana. Ventana y
# resolución se mueven juntas: 7 días a 15 min serían ~672 puntos por variable
# (y son decenas de variables), mientras que a 2 h son ~84. Con el valor por
# defecto, 24 h siguen saliendo a 15 min, así que la primera pasada no cambia.
# Por defecto: 120
PI_TARGET_POINTS_PER_VARIABLE=

# Modo demostración. En este entorno las desviaciones de prueba se generan de
# forma sintética con un ciclo periódico. Con DEMO_MODE=true se le advierte al
# modelo en el prompt del Step 6, para que no confunda esa periodicidad con una
# causa real.
# Sustituye a la práctica anterior de recortar la ventana para que no llegase a
# verla: si el patrón está en los datos, se etiqueta, no se esconde.
# EN PRODUCCIÓN DEBE QUEDARSE EN false.
# Por defecto: false
DEMO_MODE=

# Número máximo de variables que se aceptan de la selección del modelo (Step 4).
# Si la respuesta trae más, se conservan las primeras (el prompt pide al modelo
# que priorice) y se descartan las sobrantes con un WARNING en el log.
# Calibrado contra la ejecución real del 2026-08-20, donde el modelo seleccionó
# 30 variables legítimas de 164 disponibles en el AF.
# Es un guardarraíl de coste y ruido, no un límite del dominio.
# Por defecto: 40
MAX_SELECTED_VARIABLES=

# Raíz del Asset Framework a la que se restringe TODO lo que se consulte.
# El grafo es un entorno compartido: 8.404 elementos en 26 raíces (una
# cementera, Green H2, CPG, Pharma Lab, un conector de Wonderware, árboles de
# navegación...). 47 nombres de elemento del WWTP existen también en otra raíz,
# y entre ellas hay un ESPEJO de esta misma planta (WWTP_Demo, vía el conector
# de Wonderware) con los mismos nombres de equipo y atributos distintos. Sin
# acotar, un recorrido puede devolver las variables del modelo equivocado sin
# que nada falle de forma visible.
# Por defecto: WWTP
AF_PLANT_ROOT=

# Elementos del AF que se añaden al contexto de TODA alerta de esta planta,
# estén donde estén en la jerarquía. Separados por "|".
#
# El Step 2 solo ve lo que cuelga del activo y de su subsistema, así que una
# alerta del biológico no alcanza la turbidez del intake aunque sea justo lo
# que la explica. Esto lo arregla para las variables que se sepa de antemano
# que importan en toda la planta.
#
# Entran en el prompt como la prioridad MÁS BAJA: pueden influir o no, y se
# miran solo si lo cercano no explica la desviación.
#
# Vacío = ninguno. La lista la decide quien conoce la planta.
# Formato: el path del elemento, entero o desde cualquier punto, separados
# por "|". El ultimo segmento es el nombre y el resto acota, porque los
# nombres se repiten ("1 - Intake" esta dos veces dentro del WWTP).
#
# Con el sufijo "\*" entra ademas su subarbol; sin el, solo los atributos
# propios del elemento -- que es lo normal: estos sensores tienen un unico
# atributo 'Value', y sus hijos son totalizadores y configuracion.
#
# Una entrada que no resuelva NO corta el analisis: deja un WARNING en el log
# y se sigue. Es configuracion escrita a mano contra un grafo que cambia.
#
# Vacio = ninguno. Ejemplo real de esta planta:
#   AF_PLANT_CONTEXT_ELEMENTS=WWTP\Operational\1 - Intake\SS101 Intake Inlet Suspended Solids|WWTP\Operational\7 - Discharge Water\PH705 Discharge Water pH
AF_PLANT_CONTEXT_ELEMENTS=

# Tope de atributos que puede aportar el bloque de planta entero. Guardarrail
# de coste para el caso del sufijo "\*": una entrada con subarbol puede traer
# cientos de atributos al prompt de CADA alerta. Cuando recorta, lo dice.
# Por defecto: 60
MAX_PLANT_CONTEXT_ATTRIBUTES=

# Reanalisis permitidos por incidente (Fase 3). El primer analisis no cuenta:
# con 2, un expediente puede llegar a tener tres pasadas.
#
# Mientras quede presupuesto, descartar TODAS las causas NO cierra el
# incidente: se intercala el relanzado, y solo al agotarlo se concluye que la
# causa no se determino.
# Por defecto: 2
MAX_REANALISIS=

# -----------------------------------------------------------------------------
# PANTALLA DE LA SALA DE CONTROL
# -----------------------------------------------------------------------------

# Que ventana de tiempo muestra la pantalla al abrirse, en horas.
# 0 = todo el historico. Quien mira puede cambiarla desde la propia pantalla;
# esto es solo con que valor arranca.
# Por defecto: 24
SCREEN_DEFAULT_HOURS=

# Cuantos incidentes trae como maximo cada refresco.
# Por defecto: 50
SCREEN_DEFAULT_LIMIT=

# -----------------------------------------------------------------------------
# LA BUSQUEDA DEL REANALISIS (Fase 3)
# -----------------------------------------------------------------------------
# Se activa cuando alguien, al pedir un reanalisis, escribe una sospecha que
# senala un activo que no esta en el contexto del caso. Es el UNICO paso en el
# que el modelo recibe una herramienta -- una funcion nuestra de solo lectura,
# no el servidor MCP.

# Cuantas sospechas distintas se atienden en una misma pasada. Lo que sobra NO
# se descarta: queda pendiente, colgado de su causa y visible en la pantalla.
# Por defecto: 2
MAX_BUSQUEDAS_POR_PASADA=

# Vueltas del bucle, para el paso entero (no por objetivo). Una vuelta es una
# llamada al modelo. Agotarlas no es un fallo: lo que quede sin resolver sale
# como no encontrado y el analisis sigue.
# Por defecto: 5
MAX_ITERACIONES_BUSQUEDA=

# Reloj del bucle, en segundos. No es el que manda -- manda el de vueltas --,
# es la guarda contra el cuelgue. Si se sube, hay que rehacer la cuenta del
# peor caso de ANALYSIS_TIMEOUT_SECONDS.
# Por defecto: 180
BUSQUEDA_TIMEOUT_SECONDS=

# Tope de atributos de todo el bloque anadido, sumando los objetivos atendidos.
# 80 sale de una medida: el subarbol completo de una bomba son 74 atributos, y
# sus atributos propios solo 4. Anadir un activo sin sus hijos es la apariencia
# de haber atendido la sospecha sin atenderla.
# Por defecto: 80
MAX_ATRIBUTOS_ANADIDOS=

# Ramas del AF que la busqueda NO puede devolver nunca, separadas por "|". No
# son proceso: son diagramas y modelos importados, y un elemento de ahi metido
# en el contexto seria ruido con pinta de dato.
# Por defecto: Sankey Diagrams|PM_from_PME
AF_RAMAS_NO_PROCESO=

# Cuando dos causas son la misma, en porcentaje. Se compara por CONTENCION: que
# parte de las palabras con contenido de la mas corta aparece en la mas larga.
# Un reanalisis no puede proponer una causa que ya esta en el expediente: el
# operario acabaria con dos tarjetas para la misma hipotesis.
# Por defecto: 80
UMBRAL_CAUSA_REPETIDA_PCT=
