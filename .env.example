# =============================================================================
# RCA Workflow — Plantilla de configuración
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este fichero y renómbralo ".env"  (sin el ".example")
#   2. Rellena los valores que necesitas
#   3. El fichero ".env" NUNCA debe subirse a git (ya está en .gitignore)
# =============================================================================


# -----------------------------------------------------------------------------
# OBLIGATORIO
# -----------------------------------------------------------------------------

# Proveedor de LLM que usará el workflow para razonar: "gemini" (por defecto)
# o "anthropic". Solo hace falta rellenar la API key del proveedor elegido.
LLM_PROVIDER=gemini

# Clave de API de Google (Gemini). Obligatoria si LLM_PROVIDER=gemini.
# Puedes obtenerla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=aqui-va-tu-clave-de-gemini

# Clave de API de Anthropic. Obligatoria SOLO si LLM_PROVIDER=anthropic.
# Puedes obtenerla (o crearla) en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-aqui-va-tu-clave


# -----------------------------------------------------------------------------
# OPCIONALES (tienen valor por defecto si se dejan en blanco)
# -----------------------------------------------------------------------------

# Modelo de Gemini a usar (solo si LLM_PROVIDER=gemini).
# Por defecto: gemini-2.5-flash (gemini-2.5-pro requiere facturación activada
# en el proyecto de Google Cloud; sin ella devuelve error 429 de cuota 0).
GEMINI_MODEL=

# Modelo de Claude a usar (solo si LLM_PROVIDER=anthropic).
# Por defecto: claude-opus-4-8
ANTHROPIC_MODEL=

# Techo de tokens de la respuesta del modelo, para ambos proveedores.
# Es un techo duro: si se alcanza, la respuesta se corta a mitad del JSON y el
# analisis se pierde. La respuesta del Step 4 con 30 variables ya ocupa ~2.800
# tokens, y con MAX_SELECTED_VARIABLES=40 puede llegar a ~3.700.
# Subirlo no cuesta nada: solo se pagan los tokens realmente generados.
# Por defecto: 16000
LLM_MAX_TOKENS=

# Puerto en el que escuchará el servidor webhook.
# PI System debe apuntar sus notificaciones a: http://ESTE_SERVIDOR:<WEBHOOK_PORT>/notification
# Por defecto: 8090  (el 8080 está ocupado por IIS en el servidor actual)
WEBHOOK_PORT=8090

# Token secreto para verificar que las notificaciones vienen de PI System.
# Si lo configuras, PI debe enviar el mismo valor en la cabecera "X-PI-Secret".
#
# En este despliegue se deja VACIO a proposito: el canal de entrega HTTP de PI
# Notifications no permite anadir cabeceras propias, asi que exigirla dejaria el
# webhook rechazando todas las notificaciones legitimas. Ver "DECISIONES DE
# SEGURIDAD" en webhook.py. Rellenarlo solo si el emisor puede enviarla.
WEBHOOK_SECRET=

# Expone GET /notifications/history con las ultimas 50 notificaciones COMPLETAS
# (activo, jerarquia de planta, KPI, umbral) sin autenticar.
# APAGADO POR DEFECTO. Encenderlo solo de forma temporal para depurar una
# integracion nueva, y volver a apagarlo. El registro de incidentes cubre hoy
# esa necesidad mejor y sin exponer nada por HTTP.
# Por defecto: false
NOTIFICATION_HISTORY_ENABLED=

# Zona horaria del servidor para mostrar los timestamps en el log.
# Valores válidos: nombres de zona IANA, p.ej. Europe/Madrid, America/New_York
# Por defecto: Europe/Madrid
PI_LOCAL_TIMEZONE=Europe/Madrid


# -----------------------------------------------------------------------------
# OBSERVABILIDAD Y PARADA EN CALIENTE
# -----------------------------------------------------------------------------

# Log de aplicacion: una linea JSON por evento, rotativo a 10 MB x 5.
# Por defecto: <carpeta del proyecto>\webhook.log
LOG_FILE=

# Audit trail. DEBE ser un fichero distinto del log de aplicacion y sobrevivir a
# los reinicios (observability-spec 2.3 y 2.4). Formato JSON Lines, append-only.
# Por defecto: <carpeta del proyecto>udit.jsonl
AUDIT_FILE=

# Interruptor de parada en caliente (ai-governance 9.5).
# Con WORKFLOW_ENABLED=false el webhook SIGUE aceptando y registrando las
# notificaciones de PI -- no se pierde ninguna alerta -- pero NO lanza ningun
# analisis: ni LLM ni MCP servers. Los incidentes quedan en estado 'pausado'.
# Permite cortar el comportamiento automatico sin desplegar ni revertir nada.
# Requiere reiniciar el proceso tras cambiarlo.
# Por defecto: true
WORKFLOW_ENABLED=


# -----------------------------------------------------------------------------
# REGISTRO DE INCIDENTES (deduplicacion y persistencia)
# -----------------------------------------------------------------------------
# Un fichero JSON por incidente. Sirve a la vez para no analizar dos veces la
# misma alerta y para que un analisis no se pierda en silencio si el proceso
# se reinicia. Los ficheros NO se borran solos: son el archivo de casos.

# Carpeta del registro. Esta en .gitignore: guarda payloads y diagnosticos con
# datos de planta.
# Por defecto: <carpeta del proyecto>\incidents
INCIDENTS_DIR=

# Minutos durante los que una alerta del mismo activo y KPI se considera el
# mismo incidente, aunque llegue con otro StartTime. Protege del caso en que PI
# abra un event frame nuevo en cada evaluacion de la alarma.
# 0 desactiva esta capa y deja solo la deduplicacion exacta por StartTime.
#
# Recuerda: esto es una red de seguridad. La deduplicacion se arregla en PI,
# con el NonrepetitionInterval de la Notification Rule y el deadband del
# analisis que calcula el KPI.
# Por defecto: 20
INCIDENT_COOLDOWN_MINUTES=

# Dias tras los cuales se PODA el "trace" de un incidente: los prompts enviados
# al modelo y sus respuestas. El caso en si -- payload, estado, diagnostico y,
# cuando exista, la revision humana -- NO se borra nunca.
#
# El trace es el 98,9 % del peso de un incidente (medido: 501 KB de 507 KB).
# Podarlo recorta el 99 % del espacio sin tocar lo que hace falta para evaluar
# si los diagnosticos aciertan. Queda constancia de que se podo y de que habia.
#
# 90 dias da tiempo de sobra a que alguien cuestione un diagnostico y se
# investigue con el prompt original delante. 0 desactiva la poda.
# Por defecto: 90
INCIDENT_TRACE_RETENTION_DAYS=


# -----------------------------------------------------------------------------
# CONSULTAS A LOS MCP SERVERS (Steps 2 y 5)
# -----------------------------------------------------------------------------
# Los dos servidores MCP se lanzan como subproceso ("uv run --directory ..."),
# no hace falta arrancarlos a mano. Estas rutas solo hay que tocarlas si los
# proyectos no están en su ubicación habitual.

# Carpeta del proyecto afkg-graph-mcp (Step 2: estructura real del Asset Framework).
# Por defecto: C:\MCPServer\afkg-graph-mcp
AFKG_GRAPH_MCP_DIR=

# Carpeta del proyecto aveva-pi-mcp (Step 5: datos históricos de PI Web API).
# Por defecto: C:\MCPServer\MCP Server
AVEVA_PI_MCP_DIR=

# Horas hacia atrás desde la detección para la PRIMERA consulta del histórico.
# Se mira siempre hacia atrás: las alertas son degradaciones graduales de KPI,
# no picos instantáneos.
#
# Es un punto de partida, no un límite: 24 h bastan para una degradación
# gradual (validado en pruebas reales, donde la tendencia ya se ve en las
# últimas ~14 h) y mantienen el prompt del Step 6 en un tamaño razonable. Si el
# modelo, ya con los datos delante, necesita más, lo pide y el workflow repite
# los Steps 5-6 con una ventana mayor (ver MAX_HISTORY_ADJUSTMENTS).
# Por defecto: 24
PI_LOOKBACK_HOURS=

# Resolución temporal de la PRIMERA consulta (intervalo entre puntos).
# Uniforme para todas las variables, para poder correlacionarlas por timestamp.
# En las ampliaciones se recalcula sola (ver PI_TARGET_POINTS_PER_VARIABLE).
# Por defecto: 15 minutes
PI_QUERY_INTERVAL_VALUE=
PI_QUERY_INTERVAL_UNIT=

# Techo absoluto de la ventana. El modelo puede pedir más histórico, pero el
# código decide cuánto concede: la petición se recorta a este valor.
# Por defecto: 336  (14 días)
PI_MAX_LOOKBACK_HOURS=

# Cuántas veces se permite repetir los Steps 5-6 con otra ventana, a petición
# del modelo. Cuenta los reajustes en las dos direcciones: ampliaciones y
# estrechamientos. Cada uno cuesta una consulta a PI (barata) y una llamada al
# LLM (no tanto). 0 desactiva el mecanismo por completo.
# Por defecto: 1
MAX_HISTORY_ADJUSTMENTS=

# Catálogo de ventanas (en horas) que se le ofrecen al modelo. Va en las dos
# direcciones: hacia arriba para tendencias lentas, hacia abajo para fenómenos
# que a 15 minutos son invisibles (cavitación, golpe de ariete, ciclado de
# arranques). La resolución de cada opción NO se pone aquí: se deriva de
# PI_TARGET_POINTS_PER_VARIABLE, para que sea proporcional a la ventana.
# Estrechar solo se concede si la ventana sigue cubriendo el inicio de la
# desviación, que el modelo debe indicar en trend_start.
# Por defecto: 2,8,24,48,168,336  (2 h, 8 h, 24 h, 2 d, 7 d, 14 d)
PI_WINDOW_LADDER_HOURS=

# Puntos por variable a los que se aspira al ampliar la ventana. Ventana y
# resolución se mueven juntas: 7 días a 15 min serían ~672 puntos por variable
# (y son decenas de variables), mientras que a 2 h son ~84. Con el valor por
# defecto, 24 h siguen saliendo a 15 min, así que la primera pasada no cambia.
# Por defecto: 120
PI_TARGET_POINTS_PER_VARIABLE=

# Modo demostración. En este entorno las desviaciones de prueba se generan de
# forma sintética con un ciclo periódico. Con DEMO_MODE=true se le advierte al
# modelo en el prompt del Step 6, para que no confunda esa periodicidad con una
# causa real.
# Sustituye a la práctica anterior de recortar la ventana para que no llegase a
# verla: si el patrón está en los datos, se etiqueta, no se esconde.
# EN PRODUCCIÓN DEBE QUEDARSE EN false.
# Por defecto: false
DEMO_MODE=

# Número máximo de variables que se aceptan de la selección del modelo (Step 4).
# Si la respuesta trae más, se conservan las primeras (el prompt pide al modelo
# que priorice) y se descartan las sobrantes con un WARNING en el log.
# Calibrado contra la ejecución real del 2026-08-20, donde el modelo seleccionó
# 30 variables legítimas de 164 disponibles en el AF.
# Es un guardarraíl de coste y ruido, no un límite del dominio.
# Por defecto: 40
MAX_SELECTED_VARIABLES=
